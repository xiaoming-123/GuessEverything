[
  { "id": "p001", "title": "静夜思", "poet": "李白", "dynasty": "唐", "grade": 1, "famous": true, "lines": ["床前明月光", "疑是地上霜", "举头望明月", "低头思故乡"] },
  { "id": "p002", "title": "春晓", "poet": "孟浩然", "dynasty": "唐", "grade": 1, "famous": true, "lines": ["春眠不觉晓", "处处闻啼鸟", "夜来风雨声", "花落知多少"] },
  { "id": "p003", "title": "登鹳雀楼", "poet": "王之涣", "dynasty": "唐", "grade": 1, "famous": true, "lines": ["白日依山尽", "黄河入海流", "欲穷千里目", "更上一层楼"] },
  { "id": "p004", "title": "咏柳", "poet": "贺知章", "dynasty": "唐", "grade": 2, "famous": true, "lines": ["碧玉妆成一树高", "万条垂下绿丝绦", "不知细叶谁裁出", "二月春风似剪刀"] },
  { "id": "p005", "title": "望庐山瀑布", "poet": "李白", "dynasty": "唐", "grade": 2, "famous": true, "lines": ["日照香炉生紫烟", "遥看瀑布挂前川", "飞流直下三千尺", "疑是银河落九天"] },
  { "id": "p006", "title": "绝句", "poet": "杜甫", "dynasty": "唐", "grade": 2, "famous": false, "lines": ["两个黄鹂鸣翠柳", "一行白鹭上青天", "窗含西岭千秋雪", "门泊东吴万里船"] },
  { "id": "p007", "title": "悯农", "poet": "李绅", "dynasty": "唐", "grade": 1, "famous": true, "lines": ["锄禾日当午", "汗滴禾下土", "谁知盘中餐", "粒粒皆辛苦"] },
  { "id": "p008", "title": "江雪", "poet": "柳宗元", "dynasty": "唐", "grade": 3, "famous": true, "lines": ["千山鸟飞绝", "万径人踪灭", "孤舟蓑笠翁", "独钓寒江雪"] },
  { "id": "p009", "title": "小池", "poet": "杨万里", "dynasty": "宋", "grade": 2, "famous": false, "lines": ["泉眼无声惜细流", "树阴照水爱晴柔", "小荷才露尖尖角", "早有蜻蜓立上头"] },
  { "id": "p010", "title": "晓出净慈寺送林子方", "poet": "杨万里", "dynasty": "宋", "grade": 3, "famous": false, "lines": ["毕竟西湖六月中", "风光不与四时同", "接天莲叶无穷碧", "映日荷花别样红"] },
  { "id": "p011", "title": "山行", "poet": "杜牧", "dynasty": "唐", "grade": 3, "famous": true, "lines": ["远上寒山石径斜", "白云生处有人家", "停车坐爱枫林晚", "霜叶红于二月花"] },
  { "id": "p012", "title": "赠汪伦", "poet": "李白", "dynasty": "唐", "grade": 2, "famous": false, "lines": ["李白乘舟将欲行", "忽闻岸上踏歌声", "桃花潭水深千尺", "不及汪伦送我情"] },
  { "id": "p013", "title": "春日", "poet": "朱熹", "dynasty": "宋", "grade": 4, "famous": false, "lines": ["胜日寻芳泗水滨", "无边光景一时新", "等闲识得东风面", "万紫千红总是春"] },
  { "id": "p014", "title": "题西林壁", "poet": "苏轼", "dynasty": "宋", "grade": 4, "famous": true, "lines": ["横看成岭侧成峰", "远近高低各不同", "不识庐山真面目", "只缘身在此山中"] },
  { "id": "p015", "title": "饮湖上初晴后雨", "poet": "苏轼", "dynasty": "宋", "grade": 4, "famous": false, "lines": ["水光潋滟晴方好", "山色空蒙雨亦奇", "欲把西湖比西子", "淡妆浓抹总相宜"] },
  { "id": "p016", "title": "示儿", "poet": "陆游", "dynasty": "宋", "grade": 5, "famous": true, "lines": ["死去元知万事空", "但悲不见九州同", "王师北定中原日", "家祭无忘告乃翁"] },
  { "id": "p017", "title": "六月二十七日望湖楼醉书", "poet": "苏轼", "dynasty": "宋", "grade": 5, "famous": false, "lines": ["黑云翻墨未遮山", "白雨跳珠乱入船", "卷地风来忽吹散", "望湖楼下水如天"] },
  { "id": "p018", "title": "村居", "poet": "高鼎", "dynasty": "清", "grade": 2, "famous": false, "lines": ["草长莺飞二月天", "拂堤杨柳醉春烟", "儿童散学归来早", "忙趁东风放纸鸢"] },
  { "id": "p019", "title": "竹石", "poet": "郑燮", "dynasty": "清", "grade": 6, "famous": true, "lines": ["咬定青山不放松", "立根原在破岩中", "千磨万击还坚劲", "任尔东西南北风"] },
  { "id": "p020", "title": "己亥杂诗·其五", "poet": "龚自珍", "dynasty": "清", "grade": 6, "famous": true, "lines": ["浩荡离愁白日斜", "吟鞭东指即天涯", "落红不是无情物", "化作春泥更护花"] },
  { "id": "p101", "title": "次北固山下", "poet": "王湾", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["客路青山外", "行舟绿水前", "潮平两岸阔", "风正一帆悬", "海日生残夜", "江春入旧年", "乡书何处达", "归雁洛阳边"] },
  { "id": "p102", "title": "望岳", "poet": "杜甫", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["岱宗夫如何", "齐鲁青未了", "造化钟神秀", "阴阳割昏晓", "荡胸生曾云", "决眦入归鸟", "会当凌绝顶", "一览众山小"] },
  { "id": "p103", "title": "春望", "poet": "杜甫", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["国破山河在", "城春草木深", "感时花溅泪", "恨别鸟惊心", "烽火连三月", "家书抵万金", "白头搔更短", "浑欲不胜簪"] },
  { "id": "p104", "title": "使至塞上", "poet": "王维", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["单车欲问边", "属国过居延", "征蓬出汉塞", "归雁入胡天", "大漠孤烟直", "长河落日圆", "萧关逢候骑", "都护在燕然"] },
  { "id": "p105", "title": "闻王昌龄左迁龙标遥有此寄", "poet": "李白", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["杨花落尽子规啼", "闻道龙标过五溪", "我寄愁心与明月", "随君直到夜郎西"] },
  { "id": "p106", "title": "钱塘湖春行", "poet": "白居易", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["孤山寺北贾亭西", "水面初平云脚低", "几处早莺争暖树", "谁家新燕啄春泥", "乱花渐欲迷人眼", "浅草才能没马蹄", "最爱湖东行不足", "绿杨阴里白沙堤"] },
  { "id": "p107", "title": "酬乐天扬州初逢席上见赠", "poet": "刘禹锡", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["巴山楚水凄凉地", "二十三年弃置身", "怀旧空吟闻笛赋", "到乡翻似烂柯人", "沉舟侧畔千帆过", "病树前头万木春", "今日听君歌一曲", "暂凭杯酒长精神"] },
  { "id": "p108", "title": "赤壁", "poet": "杜牧", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["折戟沉沙铁未销", "自将磨洗认前朝", "东风不与周郎便", "铜雀春深锁二乔"] },
  { "id": "p109", "title": "夜雨寄北", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["君问归期未有期", "巴山夜雨涨秋池", "何当共剪西窗烛", "却话巴山夜雨时"] },
  { "id": "p110", "title": "登飞来峰", "poet": "王安石", "dynasty": "宋", "grade": 8, "famous": true, "lines": ["飞来山上千寻塔", "闻说鸡鸣见日升", "不畏浮云遮望眼", "自缘身在最高层"] },
  { "id": "p111", "title": "水调歌头·明月几时有", "poet": "苏轼", "dynasty": "宋", "grade": 9, "famous": true, "lines": ["明月几时有", "把酒问青天", "人有悲欢离合", "月有阴晴圆缺", "此事古难全", "但愿人长久", "千里共婵娟"] },
  { "id": "p112", "title": "破阵子·为陈同甫赋壮词以寄之", "poet": "辛弃疾", "dynasty": "宋", "grade": 9, "famous": true, "lines": ["醉里挑灯看剑", "梦回吹角连营", "八百里分麾下炙", "五十弦翻塞外声", "沙场秋点兵", "了却君王天下事", "赢得生前身后名", "可怜白发生"] },
  { "id": "p113", "title": "过零丁洋", "poet": "文天祥", "dynasty": "宋", "grade": 9, "famous": true, "lines": ["辛苦遭逢起一经", "干戈寥落四周星", "山河破碎风飘絮", "身世浮沉雨打萍", "惶恐滩头说惶恐", "零丁洋里叹零丁", "人生自古谁无死", "留取丹心照汗青"] },
  { "id": "p201", "title": "蜀相", "poet": "杜甫", "dynasty": "唐", "grade": 10, "famous": true, "lines": ["丞相祠堂何处寻", "锦官城外柏森森", "映阶碧草自春色", "隔叶黄鹂空好音", "三顾频烦天下计", "两朝开济老臣心", "出师未捷身先死", "长使英雄泪满襟"] },
  { "id": "p202", "title": "登高", "poet": "杜甫", "dynasty": "唐", "grade": 11, "famous": true, "lines": ["风急天高猿啸哀", "渚清沙白鸟飞回", "无边落木萧萧下", "不尽长江滚滚来", "万里悲秋常作客", "百年多病独登台", "艰难苦恨繁霜鬓", "潦倒新停浊酒杯"] },
  { "id": "p203", "title": "山居秋暝", "poet": "王维", "dynasty": "唐", "grade": 10, "famous": true, "lines": ["空山新雨后", "天气晚来秋", "明月松间照", "清泉石上流", "竹喧归浣女", "莲动下渔舟", "随意春芳歇", "王孙自可留"] },
  { "id": "p204", "title": "锦瑟", "poet": "李商隐", "dynasty": "唐", "grade": 11, "famous": true, "lines": ["锦瑟无端五十弦", "一弦一柱思华年", "庄生晓梦迷蝴蝶", "望帝春心托杜鹃", "沧海月明珠有泪", "蓝田日暖玉生烟", "此情可待成追忆", "只是当时已惘然"] },
  { "id": "p205", "title": "将进酒", "poet": "李白", "dynasty": "唐", "grade": 12, "famous": true, "lines": ["君不见黄河之水天上来", "奔流到海不复回", "君不见高堂明镜悲白发", "朝如青丝暮成雪", "人生得意须尽欢", "莫使金樽空对月", "天生我材必有用", "千金散尽还复来"] },
  { "id": "p206", "title": "念奴娇·赤壁怀古", "poet": "苏轼", "dynasty": "宋", "grade": 10, "famous": true, "lines": ["大江东去", "浪淘尽", "千古风流人物", "乱石穿空", "惊涛拍岸", "卷起千堆雪", "江山如画", "一时多少豪杰", "人生如梦", "一尊还酹江月"] },
  { "id": "p207", "title": "声声慢·寻寻觅觅", "poet": "李清照", "dynasty": "宋", "grade": 11, "famous": true, "lines": ["寻寻觅觅", "冷冷清清", "凄凄惨惨戚戚", "乍暖还寒时候", "最难将息", "满地黄花堆积", "憔悴损", "如今有谁堪摘"] },
  { "id": "p208", "title": "永遇乐·京口北固亭怀古", "poet": "辛弃疾", "dynasty": "宋", "grade": 12, "famous": true, "lines": ["千古江山", "英雄无觅", "孙仲谋处", "舞榭歌台", "风流总被", "雨打风吹去", "斜阳草树", "寻常巷陌", "人道寄奴曾住"] },
  { "id": "p209", "title": "蜀道难", "poet": "李白", "dynasty": "唐", "grade": 12, "famous": true, "lines": ["噫吁嚱", "危乎高哉", "蜀道之难", "难于上青天", "蚕丛及鱼凫", "开国何茫然", "尔来四万八千岁", "不与秦塞通人烟"] },
  { "id": "p210", "title": "游山西村", "poet": "陆游", "dynasty": "宋", "grade": 10, "famous": true, "lines": ["莫笑农家腊酒浑", "丰年留客足鸡豚", "山重水复疑无路", "柳暗花明又一村", "箫鼓追随春社近", "衣冠简朴古风存", "从今若许闲乘月", "拄杖无时夜叩门"] },
  { "id": "p211", "title": "定风波·莫听穿林打叶声", "poet": "苏轼", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["莫听穿林打叶声", "何妨吟啸且徐行", "竹杖芒鞋轻胜马", "谁怕", "一蓑烟雨任平生", "料峭春风吹酒醒", "微冷", "山头斜照却相迎", "回首向来萧瑟处", "归去", "也无风雨也无晴"] },
  { "id": "p212", "title": "无题", "poet": "李商隐", "dynasty": "唐", "grade": 11, "famous": true, "cold": 1, "lines": ["春蚕到死丝方尽", "蜡炬成灰泪始干", "晓镜但愁云鬓改", "夜吟应觉月光寒", "蓬山此去无多路", "青鸟殷勤为探看"] },
  { "id": "p213", "title": "空山", "poet": "王维", "dynasty": "唐", "grade": 10, "famous": true, "cold": 1, "lines": ["空山不见人", "但闻人语响", "返景入深林", "复照青苔上"] },
  { "id": "p214", "title": "山园小梅", "poet": "林逋", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["疏影横斜水清浅", "暗香浮动月黄昏", "霜禽欲下先偷眼", "粉蝶如知合断魂"] },
  { "id": "p215", "title": "游园不值", "poet": "叶绍翁", "dynasty": "宋", "grade": 9, "famous": true, "cold": 0, "lines": ["应怜屐齿印苍苔", "小扣柴扉久不开", "春色满园关不住", "一枝红杏出墙来"] },
  {"id": "p216", "title": "出塞 一", "poet": "王昌龄", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["秦时明月汉时关", "万里长征人未还", "但使龙城飞将在", "不教胡马度阴山"]},
  {"id": "p217", "title": "凉州词", "poet": "王之涣", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["黄沙直上白云间", "一片孤城万仞山", "羌笛何须怨杨柳", "春风不度玉门关"]},
  {"id": "p218", "title": "故行宫", "poet": "王建", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["寥落古行宫", "宫花寂寞红", "白头宫女在", "闲坐说玄宗"]},
  {"id": "p219", "title": "隋宫", "poet": "李商隐", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["乘兴南游不戒严", "九重谁省谏书函", "春风举国裁宫锦", "半作障泥半作帆"]},
  {"id": "p220", "title": "为有", "poet": "李商隐", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["为有云屏无限娇", "凤城寒尽怕春宵", "无端嫁得金龟壻", "辜负香衾事早朝"]},
  {"id": "p221", "title": "台城", "poet": "韦庄", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["江雨霏霏江草齐", "六朝如梦鸟空啼", "无情最是台城柳", "依旧烟笼十里堤"]},
  {"id": "p222", "title": "马嵬坡", "poet": "郑畋", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["宗回马杨妃死", "云雨虽亡日月新", "终是圣明天子事", "景阳宫井又何人"]},
  {"id": "p223", "title": "杂诗 十三", "poet": "无名氏", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["近寒食雨草萋萋", "著麦苗风柳映堤", "早是有家归未得", "杜鹃休向耳边啼"]},
  {"id": "p224", "title": "桃花谿", "poet": "张旭", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["隐隐飞桥隔野烟", "石矶西畔问渔船", "桃花尽日随流水", "洞在清谿何处边"]},
  {"id": "p225", "title": "将赴吴兴登乐游原一绝", "poet": "杜牧", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["清时有味是无能", "闲爱孤云静爱僧", "欲把一麾江海去", "乐游原上望昭陵"]},
  {"id": "p226", "title": "泊秦淮", "poet": "杜牧", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["烟笼寒水月笼沙", "夜泊秦淮近酒家", "商女不知亡国恨", "隔江犹唱后庭花"]},
  {"id": "p227", "title": "赠别二首 一", "poet": "杜牧", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["娉娉褭褭十三余", "豆蔻梢头二月初", "春风十里扬州路", "卷上珠帘总不如"]},
  {"id": "p228", "title": "赠别二首 二", "poet": "杜牧", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["多情却似总无情", "唯觉尊前笑不成", "蜡烛有心还惜别", "替人垂泪到天明"]},
  {"id": "p229", "title": "金谷园", "poet": "杜牧", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["繁华事散逐香尘", "流水无情草自春", "日暮东风怨啼鸟", "落花犹似堕楼人"]},
  {"id": "p230", "title": "寄人 一", "poet": "张泌", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["别梦依依到谢家", "小廊回合曲阑斜", "多情只有春庭月", "犹为离人照落花"]},
  {"id": "p231", "title": "陇西行四首 二", "poet": "陈陶", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["誓扫匈奴不顾身", "五千貂锦丧胡尘", "可怜无定河边骨", "犹是春闺梦里人"]},
  {"id": "p232", "title": "夜上受降城闻笛", "poet": "李益", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["回乐峰前沙似雪", "受降城下月如霜", "不知何处吹芦管", "一夜征人尽望乡"]},
  {"id": "p233", "title": "宿建德江", "poet": "孟浩然", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["移舟泊烟渚", "日暮客愁新", "野旷天低树", "江清月近人"]},
  {"id": "p234", "title": "和张仆射塞下曲 三", "poet": "卢纶", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["月黑鴈飞高", "单于夜遁逃", "欲将轻骑逐", "大雪满弓刀"]},
  {"id": "p235", "title": "辋川集 竹里馆", "poet": "王维", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["独坐幽篁里", "弹琴复长啸", "深林人不知", "明月来相照"]},
  {"id": "p236", "title": "送别", "poet": "王维", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["山中相送罢", "日暮掩柴扉", "春草明年绿", "王孙归不归"]},
  {"id": "p237", "title": "杂诗三首 二", "poet": "王维", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["君自故乡来", "应知故乡事", "来日绮窗前", "寒梅着花未"]},
  {"id": "p238", "title": "九月九日忆山东兄弟", "poet": "王维", "dynasty": "唐", "grade": 7, "famous": true, "lines": ["独在异乡为异客", "每逢佳节倍思亲", "遥知兄弟登高处", "遍插茱萸少一人"]},
  {"id": "p239", "title": "渭城曲", "poet": "王维", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["渭城朝雨浥轻尘", "客舍青青杨柳春", "劝君更尽一杯酒", "西出阳关无故人"]},
  {"id": "p240", "title": "终南望余雪", "poet": "祖咏", "dynasty": "唐", "grade": 6, "famous": false, "lines": ["终南阴岭秀", "积雪浮云端", "林表明霁色", "城中增暮寒"]},
  {"id": "p241", "title": "在岳咏蝉", "poet": "骆宾王", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["西陆蝉声唱", "南冠客思侵", "那堪玄鬓影", "来对白头吟", "露重飞难进", "风多响易沈", "无人信高洁", "谁为表予心"]},
  {"id": "p242", "title": "经邹鲁祭孔子而叹之", "poet": "明皇帝", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["夫子何为者", "栖栖一代中", "地犹鄹氏邑", "宅即鲁王宫", "叹凤嗟身否", "伤麟怨道穷", "今看两楹奠", "当与梦时同"]},
  {"id": "p243", "title": "蝉", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["本以高难饱", "徒劳恨费声", "五更疎欲断", "一树碧无情", "薄宦梗犹泛", "故园芜已平", "烦君最相警", "我亦举家清"]},
  {"id": "p244", "title": "风雨", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["凄凉宝剑篇", "羁泊欲穷年", "黄叶仍风雨", "青楼自管弦", "新知遭薄俗", "旧好隔良缘", "心断新丰酒", "销愁斗几千"]},
  {"id": "p245", "title": "筹笔驿", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["猿鸟犹疑畏简书", "风云常为护储胥", "徒令上将挥神笔", "终见降王走传车", "管乐有才终不忝", "关张无命欲何如", "他年锦里经祠庙", "梁父吟成恨有余"]},
  {"id": "p246", "title": "无题二首 一", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["昨夜星辰昨夜风", "画楼西畔桂堂东", "身无彩凤双飞翼", "心有灵犀一点通", "隔座送钩春酒暖", "分曹射复蜡灯红", "嗟余听鼓应官去", "走马兰台类断蓬"]},
  {"id": "p247", "title": "无题四首 一", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["来是空言去绝踪", "月斜楼上五更钟", "梦为远别啼难唤", "书被催成墨未浓", "蜡照半笼金翡翠", "麝熏微度绣芙蓉", "刘郎已恨蓬山远", "更隔蓬山一万重"]},
  {"id": "p248", "title": "无题四首 二", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["飒飒东风细雨来", "芙蓉塘外有轻雷", "金蟾啮鏁烧香入", "玉虎牵丝汲井回", "贾氏窥帘韩掾少", "宓妃留枕魏王才", "春心莫共花争发", "一寸相思一寸灰"]},
  {"id": "p249", "title": "落花", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["高阁客竟去", "小园花乱飞", "参差连曲陌", "迢遰送斜晖", "肠断未忍扫", "眼穿仍欲归", "芳心向春尽", "所得是沾衣"]},
  {"id": "p250", "title": "春雨", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["怅卧新春白袷衣", "白门寥落意多违", "红楼隔雨相望冷", "珠箔飘灯独自归", "远路应悲春晼晚", "残宵犹得梦依稀", "玉珰缄札何由达", "万里云罗一雁飞"]},
  {"id": "p251", "title": "无题二首 二", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["重帷深下莫愁堂", "卧后清宵细细长", "神女生涯原是梦", "小姑居处本无郎", "风波不信菱枝弱", "月露谁教桂叶香", "直道相思了无益", "未妨惆怅是清狂"]},
  {"id": "p252", "title": "凉思", "poet": "李商隐", "dynasty": "唐", "grade": 9, "famous": true, "lines": ["客去波平槛", "蝉休露满枝", "永怀当此节", "倚立自移时", "北斗兼春远", "南陵寓使迟", "天涯占梦数", "疑误有新知"]},
  {"id": "p253", "title": "北青萝", "poet": "李商隐", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["残阳西入崦", "茅屋访孤僧", "落叶人何在", "寒云路几层", "独敲初夜磬", "闲倚一枝藤", "世界微尘里", "吾宁爱与憎"]},
  {"id": "p254", "title": "章台夜思", "poet": "韦庄", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["清瑟怨遥夜", "遶弦风雨哀", "孤灯闻楚角", "残月下章台", "芳草已云暮", "故人殊未来", "乡书不可寄", "秋雁又南回"]},
  {"id": "p255", "title": "宫词", "poet": "薛逢", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["十二楼中尽晓妆", "望仙楼上望君王", "锁衔金兽连环冷", "水滴铜龙昼漏长", "云髻罢梳还对镜", "罗衣欲换更添香", "遥窥正殿帘开处", "袍袴宫人扫御床"]},
  {"id": "p256", "title": "楚江怀古三首 一", "poet": "马戴", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["露气寒光集", "微阳下楚丘", "猨啼洞庭树", "人在木兰舟", "广泽生明月", "苍山夹乱流", "云中君不降", "竟夕自悲秋"]},
  {"id": "p257", "title": "灞上秋居", "poet": "马戴", "dynasty": "唐", "grade": 8, "famous": true, "lines": ["灞原风雨定", "晚见鴈行频", "落叶他乡树", "寒灯独夜人", "空园白露滴", "孤壁野僧隣", "寄卧郊扉久", "何门致此身"]},
  {"id": "p258", "title": "卜算子", "poet": "陆游", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["驿外断桥边", "寂寞开无主", "已是黄昏独自愁", "更著风和雨", "无意苦争春", "一任群芳妒", "零落成泥碾作尘", "只有香如故"]},
  {"id": "p259", "title": "清平乐", "poet": "王安石", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["留春不住", "费尽莺儿语", "满地残红宫锦污", "昨夜南园风雨", "小怜初上琵琶", "晓来思绕天涯", "不肯画堂朱户", "春风自在杨花"]},
  {"id": "p260", "title": "千秋岁引", "poet": "王安石", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["别馆寒砧", "孤城画角", "一派秋声入寥廓", "东归燕从海上去", "南来雁向沙头落", "楚台风", "庾楼月", "宛如昨", "无奈被些名利缚", "无奈被他情担阁", "可惜风流总闲却", "当初漫留华表语", "而今误我秦楼约", "梦阑时", "酒醒后", "思量著"]},
  {"id": "p261", "title": "清平乐", "poet": "王安国", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["留春不住", "费尽莺儿语", "满地残红宫锦污", "昨夜南园风雨", "小怜初上琵琶", "晓来思绕天涯", "不肯画堂朱户", "春风自在梨花"]},
  {"id": "p262", "title": "临江仙", "poet": "晏几道", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["梦后楼台高锁", "酒醒帘幕低垂", "去年春恨却来时", "落花人独立", "微雨燕双飞", "记得小苹初见", "两重心字罗衣", "琵琶弦上说相思", "当时明月在", "曾照彩云归"]},
  {"id": "p263", "title": "蝶恋花", "poet": "晏几道", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["卷絮风头寒欲尽", "坠粉飘红", "日日香成阵", "新酒又添残酒困", "今春不减前春恨", "蝶去莺飞无处问", "隔水高楼", "望断双鱼信", "恼乱层波横一寸", "斜阳只与黄昏近"]},
  {"id": "p264", "title": "鹧鸪天", "poet": "晏几道", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["彩袖殷勤捧玉锺", "当年拼却醉颜红", "舞低杨柳楼心月", "歌尽桃花扇影风", "从别后", "忆相逢", "几回魂梦与君同", "今宵剩把银釭照", "犹恐相逢是梦中"]},
  {"id": "p265", "title": "生查子", "poet": "晏几道", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["关山魂梦长", "鱼雁音尘少", "两鬓可怜青", "只为相思老", "归梦碧纱窗", "说与人人道", "真个别离难", "不似相逢好"]},
  {"id": "p266", "title": "清平乐", "poet": "晏几道", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["留人不住", "醉解兰舟去", "一棹碧涛春水路", "过尽晓莺啼处", "渡头杨柳青青", "枝枝叶叶离情", "此后锦书休寄", "画楼云雨无凭"]},
  {"id": "p267", "title": "木兰花・玉楼春", "poet": "晏几道", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["秋千院落重帘暮", "彩笔闲来题绣户", "墙头丹杏雨馀花", "门外绿杨风后絮", "朝云信断知何处", "应作襄王春梦去", "紫骝认得旧游踪", "嘶过画桥东畔路"]},
  {"id": "p268", "title": "菩萨蛮", "poet": "晏几道", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["哀筝一弄湘江曲", "声声写尽湘波绿", "纤指十三弦", "细将幽恨传", "当筵秋水慢", "玉柱斜飞雁", "弹到断肠时", "春山眉黛低"]},
  {"id": "p269", "title": "玉楼春", "poet": "晏几道", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["东风又作无情计", "艳粉娇红吹满地", "碧楼帘影不遮愁", "还似去年今日意", "谁知错管春残事", "到处登临曾费泪", "此时金盏直须深", "看尽落花能几醉"]},
  {"id": "p270", "title": "阮郎归", "poet": "晏几道", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["旧香残粉似当初", "人情恨不如", "一春犹有数行书", "秋来书更疏", "衾凤冷", "枕鸳孤", "愁肠待酒舒", "梦魂纵有也成虚", "那堪和梦无"]},
  {"id": "p271", "title": "御街行", "poet": "晏几道", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["街南绿树春饶絮", "雪满游春路", "树头花艳杂娇云", "树底人家朱户", "北楼闲上", "疏帘高卷", "直见街南树", "阑干倚尽犹慵去", "几度黄昏雨", "晚春盘马踏青苔", "曾傍绿阴深驻", "落花犹在", "香屏空掩", "人面知何处"]},
  {"id": "p272", "title": "思远人", "poet": "晏几道", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["红叶黄花秋意晚", "千里念行客", "飞云过尽", "归鸿无信", "何处寄书得", "泪弹不尽临窗滴", "就砚旋研墨", "渐写到别来", "此情深处", "红笺为无色"]},
  {"id": "p273", "title": "生查子", "poet": "王观", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["关山魂梦长", "塞雁音书少", "两鬓可怜青", "一夜相思老", "归傍碧纱窗", "说与人人道", "真个别离难", "不似相逢好"]},
  {"id": "p274", "title": "临江仙", "poet": "苏轼", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["夜饮东坡醒复醉", "归来仿佛三更", "家童鼻息已雷鸣", "敲门都不应", "倚杖听江声", "长恨此身非我有", "何时忘却营营", "夜阑风静縠纹平", "小舟从此逝", "江海寄馀生"]},
  {"id": "p275", "title": "卜算子", "poet": "苏轼", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["缺月挂疏桐", "漏断人初静", "时见幽人独往来", "缥缈孤鸿影", "惊起却回头", "有恨无人省", "拣尽寒枝不肯栖", "枫落吴江冷"]},
  {"id": "p276", "title": "江神子・江城子", "poet": "苏轼", "dynasty": "宋", "grade": 12, "famous": true, "cold": 1, "lines": ["十年生死两茫茫", "不思量", "自难忘", "千里孤坟", "无处话凄凉", "纵使相逢应不识", "尘满面", "鬓如霜", "夜来幽梦忽还乡", "小轩窗", "正梳妆", "相顾无言", "惟有泪千行", "料得年年断肠处", "明月夜", "短松冈"]},
  {"id": "p277", "title": "卜算子", "poet": "李之仪", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["我住长江头", "君住长江尾", "日日思君不见君", "共饮长江水", "此水几时休", "此恨何时已", "只愿君心似我心", "定不负相思意"]},
  {"id": "p278", "title": "玉楼春", "poet": "严仁", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["春风只在园西畔", "荠菜花繁胡蝶乱", "冰池晴绿照还空", "香径落红吹已断", "意长翻恨游丝短", "尽日相思罗带缓", "宝奁明月不欺人", "明日归来君试看"]},
  {"id": "p279", "title": "生查子", "poet": "刘克庄", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["繁灯夺霁华", "戏鼓侵明发", "物色旧时同", "情味中年别", "浅画镜中眉", "深拜楼西月", "人散市声收", "渐入愁时节"]},
  {"id": "p280", "title": "玉楼春", "poet": "刘克庄", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["年年跃马长安市", "客舍似家家似寄", "青钱换酒日无何", "红烛呼庐宵不寐", "易挑锦妇机中字", "难得玉人心下事", "男儿西北有神州", "莫滴水西桥畔泪"]},
  {"id": "p281", "title": "好事近", "poet": "韩元吉", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["凝碧旧池头", "一听管弦凄切", "多少梨园声在", "总不堪华发", "杏花无处避春愁", "也傍野烟发", "惟有御沟声断", "似知人呜咽"]},
  {"id": "p282", "title": "渔家傲", "poet": "朱服", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["小雨廉纤风细细", "万家杨柳轻烟里", "恋树湿花飞不起", "愁无比", "和春付与西流水", "九十光阴能有几", "金龟解尽留无计", "寄语东城沽酒市", "拼一醉", "而今乐事他年泪"]},
  {"id": "p283", "title": "浣溪沙", "poet": "秦观", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["漠漠轻寒上小楼", "晓阴无赖似穷秋", "淡烟流水画屏幽", "自在飞花轻似梦", "无边丝雨细如愁", "宝帘闲挂小银钩"]},
  {"id": "p284", "title": "蝶恋花", "poet": "赵令", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["欲减罗衣寒未去", "不卷珠帘", "人在深深处", "红杏枝头花几许", "啼痕止恨清明雨", "尽日沈烟香一缕", "宿酒醒迟", "恼破春情绪", "飞燕又将归信误", "小屏风上西江路"]},
  {"id": "p285", "title": "醉中真・浣溪沙", "poet": "贺铸", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["不信芳春厌老人", "老人几度送春归", "惜春行乐莫辞频", "巧笑艳歌皆我意", "恼花颠酒拼君嗔", "物情惟有醉中真"]},
  {"id": "p286", "title": "人南渡・感皇恩", "poet": "贺铸", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["兰芷满芳洲", "游思横路", "罗袜尘生步", "迎顾", "整鬟颦黛", "脉脉两情难语", "细风吹柳絮", "人南渡", "回首旧游", "山无重数", "花底深朱户", "何处", "半黄梅子", "向晚一帘疏雨", "断魂分付与", "春将去"]},
  {"id": "p287", "title": "蹋莎行・踏莎行", "poet": "吴文英", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["润玉笼绡", "檀樱倚扇", "绣圈犹带脂香浅", "榴心空叠舞裙红", "艾枝应压愁鬟乱", "午梦千山", "窗阴一箭", "香瘢新褪红丝腕", "隔江人在雨声中", "晚风菰叶生秋怨"]},
  {"id": "p288", "title": "鹧鸪天", "poet": "吴文英", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["池上红衣伴倚阑", "栖鸦常带夕阳还", "殷云度雨疏桐落", "明月生凉宝扇闲", "乡梦窄", "水天宽", "小窗愁黛澹秋山", "吴鸿好为传归信", "杨柳阊门屋数间"]},
  {"id": "p289", "title": "减字浣溪沙・浣溪沙", "poet": "贺铸", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["楼角初销一缕霞", "淡黄杨柳暗栖鸦", "玉人和月摘梅花", "笑拈粉香归洞户", "更垂帘幕护窗纱", "东风寒似夜来些"]},
  {"id": "p290", "title": "蝶恋花", "poet": "贺铸", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["几许伤春春复暮", "杨柳清阴", "偏碍游丝度", "天际小山桃叶步", "白苹花满湔裙处", "竟日微吟长短句", "帘影灯昏", "心寄胡琴语", "数点雨声风约住", "朦胧淡月云来去"]},
  {"id": "p291", "title": "忆王孙", "poet": "李重元", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["萋萋芳草忆王孙", "柳外楼高空断魂", "杜宇声声不忍闻", "欲黄昏", "雨打梨花深闭门"]},
  {"id": "p292", "title": "临江仙", "poet": "陈与义", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["高咏楚词酬午日", "天涯节序匆匆", "榴花不似舞裙红", "无人知此意", "歌罢满帘风", "万事一身伤老矣", "戌葵凝笑墙东", "酒杯深浅去年同", "试浇桥下水", "今夕到湘中"]},
  {"id": "p293", "title": "点绛唇", "poet": "姜夔", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["燕雁无心", "太湖西畔随云去", "数峰清苦", "商略黄昏雨", "第四桥边", "拟共天随住", "今何许", "凭栏怀古", "残柳参差舞"]},
  {"id": "p294", "title": "鹧鸪天", "poet": "姜夔", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["肥水东流无尽期", "当初不合种相思", "梦中未比丹青见", "暗里忽惊山鸟啼", "春未绿", "鬓先丝", "人间别久不成悲", "谁教岁岁红莲夜", "两处沈吟各自知"]},
  {"id": "p295", "title": "踏莎行", "poet": "姜夔", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["燕燕轻盈", "莺莺娇软", "分明又向华胥见", "夜长争得薄情知", "春初早被相思染", "别后书辞", "别时针线", "离魂暗逐郎行远", "淮南皓月冷千山", "冥冥归去无人管"]},
  {"id": "p296", "title": "木兰花・玉楼春", "poet": "钱惟演", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["城上风光莺语乱", "城下烟波春拍岸", "绿杨芳草几时休", "泪眼愁肠先已断", "情怀渐变成衰晚", "鸾鉴朱颜惊暗换", "昔年多病厌芳尊", "今日芳尊惟恐浅"]},
  {"id": "p297", "title": "苏幕遮", "poet": "范仲淹", "dynasty": "宋", "grade": 12, "famous": true, "cold": 1, "lines": ["碧云天", "黄叶地", "秋色连波", "波上寒烟翠", "山映斜阳天接水", "芳草无情", "更在斜阳外", "黯乡魂", "追旅思", "夜夜除非", "好梦留人睡", "明月楼高休独倚", "酒入愁肠", "化作相思泪"]},
  {"id": "p298", "title": "凤栖梧・蝶恋花", "poet": "柳永", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["伫倚危楼风细细", "望极春愁", "黯黯生天际", "草色烟光残照里", "无言谁会凭阑意", "拟把疏狂图一醉", "对酒当歌", "强乐还无味", "衣带渐宽终不悔", "为伊消得人憔悴"]},
  {"id": "p299", "title": "少年游", "poet": "柳永", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["长安古道马迟迟", "高柳乱蝉栖", "夕阳岛外", "秋风原上", "目断四天垂", "归云一去无踪迹", "何处是前期", "狎兴生疏", "酒徒萧索", "不似去年时"]},
  {"id": "p300", "title": "醉垂鞭", "poet": "张先", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["双蝶绣罗裙", "东池宴", "初相见", "朱粉不深匀", "闲花淡淡春", "细看诸处好", "人人道", "柳腰身", "昨日乱山昏", "来时衣上云"]},
  {"id": "p301", "title": "天仙子", "poet": "张先", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["水调数声持酒听", "午醉醒来愁未醒", "送春春去几时回", "临晚镜", "伤流景", "往事后期空记省", "沙上并禽池上暝", "云破月来花弄影", "重重帘幕密遮灯", "风不定", "人初静", "明日落红应满径"]},
  {"id": "p302", "title": "青门引・青门饮", "poet": "张先", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["乍暖还轻冷", "风雨晚来方定", "庭轩寂寞近清明", "残花中酒", "又是去年病", "楼头画角风吹醒", "入夜重门静", "那堪更被明月", "隔墙送过秋千影"]},
  {"id": "p303", "title": "浣溪沙", "poet": "晏殊", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["一曲新词酒一杯", "去年天气旧亭台", "夕阳西下几时回", "无可奈何花落去", "似曾相识燕归来", "小园香径独徘徊"]},
  {"id": "p304", "title": "清平乐", "poet": "晏殊", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["金风细细", "叶叶梧桐坠", "绿酒初尝人易醉", "一枕小窗浓睡", "紫微朱槿花残", "斜阳却照阑干", "双燕欲归时节", "银屏昨夜微寒"]},
  {"id": "p305", "title": "木兰花・玉楼春", "poet": "晏殊", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["燕鸿过后莺归去", "细算浮生千万绪", "长于春梦几多时", "散似秋云无觅处", "闻琴解佩神仙侣", "挽断罗衣留不住", "劝君莫作独醒人", "烂醉花间应有数"]},
  {"id": "p306", "title": "踏莎行", "poet": "晏殊", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["祖席离歌", "长亭别宴", "香尘已隔犹回面", "居人匹马映林嘶", "行人去棹依波转", "画阁魂消", "高楼目断", "斜阳只送平波远", "无穷无尽是离愁", "天涯地角寻思遍"]},
  {"id": "p307", "title": "玉楼春", "poet": "晏殊", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["绿杨芳草长亭路", "年少抛人容易去", "楼头残梦五更钟", "花底离情三月雨", "无情不似多情苦", "一寸还成千万缕", "天涯地角有穷时", "只有相思无尽处"]},
  {"id": "p308", "title": "玉楼春", "poet": "宋祁", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["东城渐觉风光好", "皱波纹迎客棹", "绿杨烟外晓寒轻", "红杏枝头春意闹", "浮生长恨欢娱少", "肯爱千金轻一笑", "为君持酒劝斜阳", "且向花间留晚照"]},
  {"id": "p309", "title": "采桑子", "poet": "欧阳修", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["群芳过后西湖好", "狼籍残红", "飞絮蒙蒙", "垂柳阑干尽日风", "笙歌散尽游人去", "始觉春空", "垂下帘栊", "双燕归来细雨中"]},
  {"id": "p310", "title": "诉衷情", "poet": "欧阳修", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["清晨帘幕卷轻霜", "呵手试梅妆", "都缘自有离恨", "故画作远山长", "思往事", "惜流芳", "易成伤", "拟歌先敛", "欲笑还颦", "最断人肠"]},
  {"id": "p311", "title": "踏莎行", "poet": "欧阳修", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["候馆梅残", "溪桥柳细", "草熏风暖摇征辔", "离愁渐远渐无穷", "迢迢不断如春水", "寸寸柔肠", "盈盈粉泪", "楼高莫近危阑倚", "平芜尽处是春山", "行人更在春山外"]},
  {"id": "p312", "title": "蝶恋花", "poet": "欧阳修", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["独倚危楼风细细", "望极离愁", "黯黯生天际", "草色山光残照里", "无人会得凭阑意", "也拟疏狂图一醉", "对酒当歌", "强饮还无味", "衣带渐宽都不悔", "况伊销得人憔悴"]},
  {"id": "p313", "title": "玉楼春", "poet": "欧阳修", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["燕鸿过后春归去", "细算浮生千万绪", "来如春梦几多时", "去似朝云无觅处", "闻琴解神仙侣", "挽断罗衣留不住", "劝君莫作独醒人", "烂醉花间应有数"]},
  {"id": "p314", "title": "浪淘沙", "poet": "欧阳修", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["把酒祝东风", "且共从容", "垂杨紫陌洛城东", "总是当时携手处", "游遍芳丛", "聚散苦匆匆", "此恨无穷", "今年花胜去年红", "可惜明年花更好", "知与谁同"]},
  {"id": "p315", "title": "江城子", "poet": "卢祖皋", "dynasty": "宋", "grade": 12, "famous": true, "cold": 1, "lines": ["画楼帘幕卷新晴", "掩银屏", "晓寒轻", "坠粉飘香", "日日唤愁生", "暗数十年湖上路", "能几度", "著娉婷", "年华空自感飘零", "拥春酲", "对谁醒", "天阔云闲", "无处觅箫声", "载酒买花年少事", "浑不似", "旧心情"]},
  {"id": "p316", "title": "小重山", "poet": "章良能", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["柳暗花明春事深", "小阑红芍药", "已抽簪", "雨馀风软碎鸣禽", "迟迟日", "犹带一分阴", "往事莫沈吟", "身闲时序好", "且登临", "旧游无处不堪寻", "无寻处", "惟有少年心"]},
  {"id": "p317", "title": "浣溪沙", "poet": "吴文英", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["门隔花深梦旧游", "夕阳无语燕归愁", "玉纤香动小帘钩", "落絮无声春堕泪", "行云有影月含羞", "东风临夜冷于秋"]},
  {"id": "p318", "title": "点绛唇", "poet": "吴文英", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["卷尽愁云", "素娥临夜新梳洗", "暗尘不起", "酥润凌波地", "辇路重来", "仿佛灯前事", "情如水", "小楼熏被", "春梦笙歌里"]},
  {"id": "p319", "title": "醉花阴", "poet": "李清照", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["薄雾浓云愁永昼", "瑞脑消金兽", "佳节又重阳", "玉枕纱厨", "半夜凉初透", "东篱把洒黄昏后", "有暗香盈袖", "莫道不消魂", "帘卷西风", "人似黄花瘦"]},
  {"id": "p320", "title": "鹧鸪天", "poet": "辛弃疾", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["枕簟溪堂冷欲秋", "断云依水晚来收", "红莲相倚浑如醉", "白鸟无言定自愁", "书咄咄", "且休休", "一丘一壑也风流", "不知筋力衰多少", "但觉新来懒上楼"]},
  {"id": "p321", "title": "菩萨蛮", "poet": "辛弃疾", "dynasty": "宋", "grade": 8, "famous": true, "cold": 1, "lines": ["郁孤台下清江水", "中间多少行人泪", "西北是长安", "可怜无数山", "青山遮不住", "毕竟江流去", "江晚正愁予", "山深闻鹧鸪"]},
  {"id": "p322", "title": "临江仙", "poet": "晁冲之", "dynasty": "宋", "grade": 11, "famous": true, "cold": 1, "lines": ["忆昔西池池上饮", "年年多少欢娱", "别来不寄一行书", "寻常相见了", "犹道不如初", "安稳锦屏今夜梦", "月明好度江湖", "相思休问定何如", "情知春去后", "管得落花无"]},
  {"id": "p323", "title": "惜分飞", "poet": "毛滂", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["泪湿阑干花著露", "愁到眉峰碧聚", "此恨平分取", "更无言语", "空相觑", "短雨残云无意绪", "寂寞朝朝暮暮", "今夜山深处", "断魂分付", "潮回去"]},
  {"id": "p324", "title": "点绛唇", "poet": "苏过", "dynasty": "宋", "grade": 10, "famous": true, "cold": 1, "lines": ["新月娟娟", "夜寒江静山衔斗", "起来搔首", "梅影横窗瘦", "好个霜天", "闲却传杯手", "君知否", "乱鸦啼后", "归兴浓如酒"]},
