// 谜盒 · 数据模型
// 嵌入式 SQLite 单文件库（零运维，适合单节点部署），DATABASE_URL 见 .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 诗词语料（chinese-poetry 抽取入库，学段分级）
model Poem {
  id      String @id @default(cuid())
  title   String
  poet    String
  dynasty String
  /// 学段分级 1-12：小学 1-6 / 初中 7-9 / 高中 10-12
  grade   Int
  /// 全文诗句，按序排列
  lines   Json
  /// 是否为名句（优先用于名句猜诗人/诗名）
  famous  Boolean @default(false)

  @@index([grade])
  @@index([poet])
}

/// 演员语料（纯文字：姓名 / 代表作 / 经典角色，禁止肖像与剧照）
model Actor {
  id         String @id @default(cuid())
  name       String
  /// 地区：MAINLAND | HK_TW | OVERSEAS
  region     String
  /// 难度 1-3：1 入门 / 2 进阶 / 3 骨灰
  difficulty Int
  /// 代表作作品名列表
  works      Json
  /// 经典角色 [{ role, work }]
  roles      Json

  @@index([difficulty])
  @@index([region])
}

/// 物品语料（名称 / 分类 / 特征线索 / 公版民间谜语谜面）
model ObjectItem {
  id         String  @id @default(cuid())
  name       String
  /// 分类：ANIMAL | PLANT | FOOD | DAILY | STATIONERY | NATURE
  category   String
  /// 难度 1-3：1 入门 / 2 进阶 / 3 骨灰
  difficulty Int
  /// 特征线索（由笼统到具体）
  clues      Json
  /// 公版民间谜语谜面（可空）
  riddle     String?

  @@index([difficulty])
  @@index([category])
}

/// 匿名玩家（自动分配昵称，可改名）
model Player {
  id        String   @id @default(cuid())
  nickname  String
  /// emoji 头像
  avatar    String
  createdAt DateTime @default(now())

  sessions   GameSession[]
  progresses PlayerProgress[]
  rank       PlayerRank?
}

/// 玩家关卡进度（每模式每关卡一条，取历史最优）
model PlayerProgress {
  id           String @id @default(cuid())
  playerId     String
  mode         String // POETRY | ACTOR | OBJECT
  stage        String // 学段/难度
  bestScore    Int    @default(0)
  /// 最佳正确率（百分比 0-100）
  bestAccuracy Int    @default(0)
  /// 星级 0-3（60/80/95% 正确率）
  stars        Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, mode, stage])
  @@index([mode, stage, stars])
}

/// 玩家官阶档案（诗词升官线：布衣 → 11 阶官衔 + 皇帝，架空称号路线）
/// 一玩家一条；功名（totalExp）只增不减，失败/弃局不扣
model PlayerRank {
  playerId  String   @unique
  /// 当前官阶 id（0..10，对应 rank.ts 的 RANKS）
  rank      Int      @default(0)
  /// 累计功名（单调不减；由对局结算一次性记账）
  totalExp  Int      @default(0)
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// 玩家「已见题」持久化记录（诗词升官线专用）
/// 出题即占用（sourceKey/faceKey 任一维度），会试/科考/每日题严格排除已见；
/// 永久保留（重启不遗忘）；旧学段模式仍用进程内 LRU，互不影响
model PlayerSeenKey {
  playerId String
  /// 素材 key（poemId:lineIndex:questionType）
  key      String
  createdAt DateTime @default(now())

  @@unique([playerId, key])
  @@index([playerId])
}

/// 一次对局会话：轮次完整数据（含答案）仅存服务端，永不下发
model GameSession {
  id        String   @id @default(cuid())
  mode      String // POETRY | ACTOR | OBJECT | FEIHUALING
  /// 对局形态：STAGE 学段闯关（旧玩法）| RANKED 官阶模式（诗词升官）
  kind      String   @default("STAGE")
  /// 学段/难度快照（RANKED 模式下为研习/科考标记）
  stage     String
  /// 官阶模式专用：出题所在官阶 id（EXAM 时为目标官阶）
  rankId    Int?
  /// 出题引擎产出的轮次数据（含 answer，服务端专用）
  rounds    Json
  /// 轮次总数
  roundCount Int
  status    String   @default("ACTIVE") // ACTIVE | FINISHED | EXPIRED
  score     Int      @default(0)
  /// 对局有效截止时间（防作弊：过期会话拒绝提交）
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// 归属玩家（排行榜/进度归集）；旧会话与未注册玩家为空
  playerId  String?
  /// 结算一次性记账标记（playerId:kind 的幂等键，结算时 create 占位，重复结算即冲突）
  settleKey String?

  answers AnswerRecord[]
  player  Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([playerId])
  @@index([mode, stage, score])
}

/// 每轮作答记录（错题本/结算回顾数据来源）
model AnswerRecord {
  id         String   @id @default(cuid())
  sessionId  String
  roundIndex Int
  /// 玩家选择/填写的答案
  given      String
  /// 服务端判题结果
  correct    Boolean
  /// 该题正确答案（结算/错题本展示用）
  correctAnswer String
  /// 响应耗时 ms，用于计分
  timeMs     Int
  /// 本题判分（= score.ts computeScore 的 gained；结算时从 DB 求和，崩溃可恢复）
  gained     Int      @default(0)
  createdAt  DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, roundIndex])
  @@index([sessionId])
}
