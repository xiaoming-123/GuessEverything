// 谜盒 · 数据模型
// 嵌入式 SQLite 单文件库（零运维，适合单节点部署），DATABASE_URL 见 .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 诗词语料（chinese-poetry 抽取入库，学段分级）
model Poem {
  id      String @id @default(cuid())
  title   String
  poet    String
  dynasty String
  /// 学段分级 1-12：小学 1-6 / 初中 7-9 / 高中 10-12
  grade   Int
  /// 全文诗句，按序排列
  lines   Json
  /// 是否为名句（优先用于名句猜诗人/诗名）
  famous  Boolean @default(false)

  @@index([grade])
  @@index([poet])
}

/// 匿名玩家（自动分配昵称，可改名）
model Player {
  id        String   @id @default(cuid())
  nickname  String
  /// emoji 头像
  avatar    String
  createdAt DateTime @default(now())

  sessions GameSession[]
  rank     PlayerRank?
}

/// 玩家官阶档案（诗词升官线：布衣 → 11 阶官衔 + 皇帝，架空称号路线）
/// 一玩家一条；功名（totalExp）只增不减，失败/弃局不扣
model PlayerRank {
  playerId  String   @unique
  /// 当前官阶 id（0..10，对应 rank.ts 的 RANKS）
  rank      Int      @default(0)
  /// 累计功名（单调不减；由对局结算一次性记账）
  totalExp  Int      @default(0)
  /// 已发放周奖键集（形如 ["2026-W38"]，结算事务补记幂等，详设 §2.1 review B3）
  weeklyBonusKeys Json @default("[]")
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

/// 每日题记录（幂等：一玩家一日一局，详设 §2.1）
/// 无外键、只有 playerId 字符串——与既有 PlayerSeenKey 同风格，有意为之
/// （匿名体系下玩家不删、免迁移负担，后人勿「补全外键」，review B10）
model PlayerDaily {
  playerId String
  /// 服务端本地日期 YYYY-MM-DD（Asia/Shanghai）
  date     String
  /// 关联会话 id
  sessionId String
  /// 是否已结算（未结算可续答，TTL 内）
  settled  Boolean  @default(false)
  /// 补签标记（review A10）：仅对「过期未答」的历史日可由补签置 true；
  /// 只影响月历展示与周连满判定，不加功名。真实作答日恒 false
  madeUp   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([playerId, date])
  @@index([playerId, date])
}

/// 玩家已获成就（幂等唯一，详设 §2.2）
model PlayerAchievement {
  playerId String
  /// 成就 key（纯逻辑层 ACHIEVEMENTS 表定义）
  key      String
  earnedAt DateTime @default(now())

  @@unique([playerId, key])
  @@index([playerId])
}

/// 玩家「已见题」持久化记录（诗词升官线专用）
/// 出题即占用（sourceKey/faceKey 任一维度），会试/科考/每日题严格排除已见；
/// 永久保留（重启不遗忘）；旧学段模式仍用进程内 LRU，互不影响
model PlayerSeenKey {
  playerId String
  /// 素材 key（poemId:lineIndex:questionType）
  key      String
  createdAt DateTime @default(now())

  @@unique([playerId, key])
  @@index([playerId])
}

/// 一次对局会话：轮次完整数据（含答案）仅存服务端，永不下发
model GameSession {
  id        String   @id @default(cuid())
  mode      String // POETRY
  /// 对局形态：RANKED 官阶模式（诗词升官）
  kind      String   @default("RANKED")
  /// 学段/难度快照（RANKED 模式下为研习/科考标记）
  stage     String
  /// 官阶模式专用：出题所在官阶 id（EXAM 时为目标官阶）
  rankId    Int?
  /// 出题引擎产出的轮次数据（含 answer，服务端专用）
  rounds    Json
  /// 轮次总数
  roundCount Int
  status    String   @default("ACTIVE") // ACTIVE | FINISHED | EXPIRED
  score     Int      @default(0)
  /// 本局正确率（0-100，结算事务写入；RANKED 局 recentGames 展示用，D1 详设 §2.3）
  accuracy  Int      @default(0)
  /// 对局有效截止时间（防作弊：过期会话拒绝提交）
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// 归属玩家；未注册玩家为空
  playerId  String?
  /// 结算一次性记账标记（playerId:kind 的幂等键，结算时 create 占位，重复结算即冲突）
  settleKey String?
  /// 问同窗已用标记（D4 详设 §4.1：一局一次；结算功名 ×0.8）
  hintUsed Boolean @default(false)
  /// 提示作用于第几题（review A9：持久化，resume 按题恢复灰置）
  hintRoundIndex Int?
  /// 被移除的选项索引（2 个错误选项；客户端仅当 roundIndex 匹配时灰置）
  hintRemoved Json @default("[]")

  answers AnswerRecord[]
  player  Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([playerId])
  @@index([mode, stage, score])
}

/// 每轮作答记录（错题本/结算回顾数据来源）
model AnswerRecord {
  id         String   @id @default(cuid())
  sessionId  String
  roundIndex Int
  /// 玩家选择/填写的答案
  given      String
  /// 服务端判题结果
  correct    Boolean
  /// 该题正确答案（结算/错题本展示用）
  correctAnswer String
  /// 响应耗时 ms，用于计分
  timeMs     Int
  /// 本题判分（= score.ts computeScore 的 gained；结算时从 DB 求和，崩溃可恢复）
  gained     Int      @default(0)
  createdAt  DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, roundIndex])
  @@index([sessionId])
}

/// 诗词阁（D3 详设 §3.1）：玩家答过的诗，按 poemId 去重，答过即入库（不论对错）
/// 与 PlayerSeenKey 是两个维度：阁按「诗」去重（收集进度），SeenKey 按「素材」去重（防重出）
model PlayerPoem {
  playerId String
  /// 语料 Poem.id（= sourceKey 第一段，judge 落库点由 sourceKey 还原，详设 §3.1）
  poemId   String
  title    String
  poet     String
  dynasty  String
  grade    Int
  /// 该诗在阁内首次答对过（展示「已通」标记；仅当本题 correct 且未 mastered 时置 true）
  mastered   Boolean  @default(false)
  seenAt     DateTime @default(now())

  @@unique([playerId, poemId])
  @@index([playerId, dynasty])
  @@index([playerId, poet])
}

/// 剪影竞猜（D4 详设 §4.2：一玩家一日一次；猜 rankId+2 迷雾阶称号）
/// 无外键、只有 playerId 字符串——与 PlayerSeenKey/PlayerDaily 同风格（review B10）
model RankGuess {
  playerId   String
  /// 服务端本地日期 YYYY-MM-DD（Asia/Shanghai）
  date       String
  /// 玩家选的称号（选项由前端从 RANKS 渲染，服务端不下发选项池）
  guessLabel String
  /// 是否猜中（= guessLabel === RANKS[rank+2].label，结算时刻读当前官阶）
  correct    Boolean
  /// 猜中授予的功名（+100；不走 0.8 折价——提示代价只作用对局）
  gained     Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([playerId, date])
  @@index([playerId])
}
