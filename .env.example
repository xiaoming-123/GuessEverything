# 数据库（测试期 Supabase PostgreSQL）
# 示例：postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/mystery_box"
# Prisma DDL 直连（Supabase 会话池 5432）；本地单库可与 DATABASE_URL 相同
# DIRECT_URL="postgresql://user:password@localhost:5432/mystery_box"

# 本地开发开关：=1 强制内存模式，完全不连数据库（零延迟/可离线）；
# 游戏闭环正常，但玩家档案/排行榜/进度归档不可用。生产不要设置。
# USE_MEMORY_DB="1"

# RSA 私钥（PKCS#8 PEM，\n 转义）。
# 未配置时本地开发会自动生成内存密钥对（重启失效）；生产环境必须配置！
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt
CRYPTO_RSA_PRIVATE_KEY=""
